[Unit]
Description=BotClima Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/BotClima
EnvironmentFile=/root/BotClima/.env
ExecStart=/root/BotClima/venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
